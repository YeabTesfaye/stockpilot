{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma contract emit && dotenv -e .env -- npx prisma db migrate && next build",
    "build:app": "npx prisma contract emit && next build",
    "db:migrate": "dotenv -e .env -- npx prisma db migrate",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/cli-engine": "^0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "8.0.0-rc.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
