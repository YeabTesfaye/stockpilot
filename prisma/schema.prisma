// use prisma-next

enum Role {
  OWNER
  PRODUCTION_MANAGER
  PURCHASING
  WAREHOUSE_STAFF
  VIEWER
}

model Tenant {
  id        String            @id @default(uuid())
  name      String
  createdAt TimestamptzString @default(now()) @map("created_at")
  users     Membership[]

  @@map("tenants")
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String            @map("password_hash")
  createdAt    TimestamptzString @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")
  memberships  Membership[]
  sessions     Session[]

  @@map("users")
}

model Membership {
  id        String @id @default(uuid())
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String @map("tenant_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String @map("user_id")
  role      Role
  createdAt TimestamptzString @default(now()) @map("created_at")

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Session {
  id        String            @id @default(uuid())
  tokenHash String            @unique @map("token_hash")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String            @map("user_id")
  expiresAt TimestamptzString @map("expires_at")
  revokedAt TimestamptzString? @map("revoked_at")
  createdAt TimestamptzString @default(now()) @map("created_at")

  @@map("sessions")
}

// ── Catalog entities (Day 4) ──────────────────────────────────────────────
// All catalog tables are tenant-owned: every row carries tenant_id and is
// RLS-protected by the policies in prisma/policies.sql. SKU uniqueness is
// scoped per tenant (the unique constraint includes tenant_id).

model Material {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String   @map("tenant_id")
  name        String   @map("name")
  sku         String   @map("sku")
  description String?  @map("description")
  unit        String   @map("unit")
  minStock    Int      @default(0) @map("min_stock")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  @@unique([tenantId, sku])
  @@map("materials")
}

model Product {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String   @map("tenant_id")
  name        String   @map("name")
  sku         String   @map("sku")
  description String?  @map("description")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  // Current BOM (latest version). Set in application code by querying
  // MAX(version) for this product. Not a DB-level FK to enforce "current".
  currentBom  Bom?     @relation(fields: [currentBomId], references: [id])
  currentBomId String? @map("current_bom_id")

  @@unique([tenantId, sku])
  @@map("products")
}

model Warehouse {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String   @map("tenant_id")
  name        String   @map("name")
  code        String?  @map("code")
  address     String?  @map("address")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  @@map("warehouses")
}

// Versioned bill of materials (Day 5).
// Each product has a BOM — the latest version is the active one.
// BOMItem rows belong to a specific BOM version, not directly to the product.

model Bom {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  version     Int      @map("version")
  effectiveAt TimestamptzString @default(now()) @map("effective_at")
  createdAt   TimestamptzString @default(now()) @map("created_at")

  items       BomItem[]

  @@unique([productId, version])
  @@map("boms")
}

// Line items for a specific BOM version.
model BomItem {
  id                String   @id @default(uuid())
  bom               Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  bomId             String   @map("bom_id")
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId        String   @map("material_id")
  quantityPerUnit   Float    @map("quantity_per_unit")
  unit              String   @map("unit")
  createdAt         TimestamptzString @default(now()) @map("created_at")

  @@map("bom_items")
}
